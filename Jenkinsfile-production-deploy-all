/* groovylint-disable CompileStatic, DuplicateMapLiteral, DuplicateStringLiteral, LineLength, MethodSize, NestedBlockDepth, NglParseError */
@Library('bao-shared') _

pipeline {
    agent any

    options {
        timeout(time: 40, unit: 'MINUTES')
    }

    parameters {
        booleanParam(name: 'SETUP_SERVER', defaultValue: false, description: 'Pass through to the backend/frontend jobs (one-time server bootstrap).')
        string(name: 'BACKEND_JOB', defaultValue: 'baoafrik-production-backend', description: 'Jenkins job name of the backend pipeline')
        string(name: 'FRONTEND_JOB', defaultValue: 'baoafrik-production-frontend', description: 'Jenkins job name of the frontend pipeline')
    }

    environment {
        NODE_ENV = 'production'
        DOMAIN = 'baoafrik.com'
        SLACK_CHANNEL = '#prod-deploy-release-notes'
        EMAIL = 'pageo.fonsah@baotechnologiesandtravels.com'
        BAOTECHNOLOGIES_DEV_TEAM = 'toni.ebong@baotechnologiesandtravels.com'
    }

    stages {
        stage('Deploy backend') {
            steps {
                echo "Deploying backend via ${params.BACKEND_JOB}..."
                build job: params.BACKEND_JOB,
                    parameters: [booleanParam(name: 'SETUP_SERVER', value: params.SETUP_SERVER)],
                    wait: true,
                    propagate: true
            }
        }

        stage('Deploy frontend') {
            steps {
                echo "Deploying frontend via ${params.FRONTEND_JOB}..."
                build job: params.FRONTEND_JOB,
                    parameters: [booleanParam(name: 'SETUP_SERVER', value: params.SETUP_SERVER)],
                    wait: true,
                    propagate: true
            }
        }
    }

    post {
        always {
            script {
                emailext(
                        subject: "${env.JOB_NAME} - Build #${env.BUILD_NUMBER} - ${currentBuild.currentResult}",
                        to: "${env.EMAIL}",
                        from: 'no-reply@baoafrik.com',
                        replyTo: 'no-reply@baoafrik.com',
                        body: """
                            <html>
                                <body style="font-family: Arial, sans-serif; line-height: 1.5; color: #333;">
                                    <h2 style="color: #2E86C1;">BaoAfrik Full-Stack Deploy Notification</h2>
                                    <p><strong>Job:</strong> ${env.JOB_NAME}</p>
                                    <p><strong>Build Number:</strong> ${env.BUILD_NUMBER}</p>
                                    <p><strong>Status:</strong> <span style="color: ${currentBuild.currentResult == 'SUCCESS' ? 'green' : 'red'};">${currentBuild.currentResult}</span></p>
                                    <p>Check the <a href="${env.BUILD_URL}">console output</a> for details.</p>
                                    <hr>
                                    <p style="font-size: 0.9em; color: #565;">This is an automated email from Jenkins. Please do not reply.</p>
                                </body>
                            </html>
                        """,
                        mimeType: 'text/html'
                )
            }
        }
        success {
            sendSlackNotification(
                status: 'SUCCESS',
                color: 'good',
                channel: env.SLACK_CHANNEL,
                releaseNotes: "Full-stack deployment completed to https://${env.DOMAIN} (backend + frontend)."
            )
        }
    }
}
