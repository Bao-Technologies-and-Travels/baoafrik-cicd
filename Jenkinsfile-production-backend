/* groovylint-disable CompileStatic, DuplicateMapLiteral, DuplicateStringLiteral, LineLength, MethodSize, NestedBlockDepth, NglParseError */
@Library('bao-shared') _

pipeline {
    agent any

    options {
        timeout(time: 20, unit: 'MINUTES')
    }

    parameters {
        booleanParam(name: 'SETUP_SERVER', defaultValue: false, description: 'Run the one-time server bootstrap (apt, Node.js, pm2, nginx, certbot, postgres). Leave unchecked for regular deploys.')
        booleanParam(name: 'PRISMA_SIGN_DB', defaultValue: false, description: 'One-time Prisma 8 adoption: sign the existing database against the current contract. Tick only on the cutover deploy, then leave unchecked.')
    }

    environment {
        NODE_ENV = 'production'
        SSH_KEY_ID = 'baoafrik-key'
        SSH_HOST = 'ashprincepageo@34.51.136.137'
        APP_DIR = '$HOME/baoafrik-backend'
        APP_NAME = 'backend'
        REPO_URL = 'git@github.com:Bao-Technologies-and-Travels/baoafrik-backend.git'
        BRANCH = 'main'
        REPO = 'baoafrik-backend'
        DOMAIN = 'baoafrik.com'
        EMAIL = 'pageo.fonsah@baotechnologiesandtravels.com'
        BAOTECHNOLOGIES_DEV_TEAM = 'toni.ebong@baotechnologiesandtravels.com'
        SLACK_CHANNEL = '#prod-deploy-release-notes'
        LAST_COMMIT_FILE = '$HOME/last_deployed_commit_backend_prod.txt'
        GIT_PREVIOUS_COMMIT = ''
        GIT_COMMIT = ''
        WEEKLY_REPORT_RECIPIENTS = 'toni.ebong@baotechnologiesandtravels.com'
    }

    stages {
        stage('Setup server dependencies') {
            when {
                expression { return params.SETUP_SERVER }
            }
            steps {
                echo 'Bootstrapping server dependencies (one-time, on-demand)...'

                sshagent([env.SSH_KEY_ID]) {
                    sh """
                    ssh -o StrictHostKeyChecking=no ${SSH_HOST} '
                        set -e

                        # Refresh package index only (no dist-upgrade during deploys)
                        sudo apt-get update -qq

                        # Node.js 24.x, only when missing or on an older major version
                        NODE_MAJOR=\$(node --version 2>/dev/null | cut -d. -f1 | tr -dc "0-9" || true)
                        if [ "\${NODE_MAJOR:-0}" -lt 24 ]; then
                            curl -fsSL https://deb.nodesource.com/setup_24.x | sudo -E bash -
                            sudo apt-get install -y nodejs
                        fi

                        # Global tools, only when missing (no upgrade on every deploy)
                        command -v pm2   >/dev/null 2>&1 || sudo npm install -g pm2@latest
                        command -v serve >/dev/null 2>&1 || sudo npm install -g serve
                        pm2 startup systemd >/dev/null 2>&1 || true

                        # Reverse proxy and SSL, only when missing
                        command -v nginx   >/dev/null 2>&1 || sudo apt-get install -y nginx
                        command -v certbot >/dev/null 2>&1 || sudo apt-get install -y certbot python3-certbot-nginx

                        # Database, only for the backend server
                        if [ "${APP_NAME}" = "backend" ]; then
                            command -v psql >/dev/null 2>&1 || sudo apt-get install -y postgresql postgresql-client-common
                        fi

                        echo "Server dependencies ready."
                    '
                    """
                }
            }
        }

        stage('Clone backend Repository') {
            steps {
                echo 'Cloning repository...'
                sshagent([env.SSH_KEY_ID]) {
                    sh '''
                    ssh -o StrictHostKeyChecking=no ''' + SSH_HOST + ''' '
                        set -e

                        # Get current commit hash before cloning/pulling
                        CURRENT_COMMIT=$(git ls-remote ''' + REPO_URL + ''' ''' + BRANCH + ''' | cut -f1)
                        echo "Current commit: $CURRENT_COMMIT"

                        if [ ! -d ~/baoafrik-backend ]; then
                            git clone -b ''' + BRANCH + ''' ''' + REPO_URL + ''' ~/baoafrik-backend
                        fi

                        cd ''' + APP_DIR + '''

                        # Store previous commit for changelog from last deployed file
                        if [ -f ~/last_deployed_commit_backend_prod.txt ]; then
                            cat ~/last_deployed_commit_backend_prod.txt > /tmp/previous_commit_backend_prod.txt
                        else
                            echo "" > /tmp/previous_commit_backend_prod.txt
                        fi

                        git fetch origin ''' + BRANCH + '''
                        git checkout ''' + BRANCH + '''
                        git reset --hard origin/''' + BRANCH + '''

                        # Store current commit for environment
                        echo "$CURRENT_COMMIT" > /tmp/current_commit_backend_prod.txt

                        echo "Backend repository cloned/updated successfully."
                    '
                    '''

                    // Get previous and current commits for changelog
                    script {
                        String previousCommit = sh(
                            script: "ssh -o StrictHostKeyChecking=no ${SSH_HOST} 'cat /tmp/previous_commit_backend_prod.txt 2>/dev/null || echo \"\"'",
                            returnStdout: true
                        ).trim()
                        String currentCommit = sh(
                            script: "ssh -o StrictHostKeyChecking=no ${SSH_HOST} 'cat /tmp/current_commit_backend_prod.txt 2>/dev/null || echo \"\"'",
                            returnStdout: true
                        ).trim()
                        env.GIT_PREVIOUS_COMMIT = previousCommit
                        env.GIT_COMMIT = currentCommit
                    }
                }
            }
        }

        stage('Setup Backend Environment') {
            steps {
                withCredentials([
                    string(credentialsId: 'db_url', variable: 'DATABASE_URL'),
                    string(credentialsId: 'jwt_secret', variable: 'JWT_SECRET'),
                    string(credentialsId: 'jwt_refresh_secret', variable: 'JWT_REFRESH_SECRET'),
                    string(credentialsId: 'resend_api_key', variable: 'RESEND_API_KEY'),
                    string(credentialsId: 'gcp_project_id',      variable: 'GCP_PROJECT_ID'),
                    string(credentialsId: 'gcp_client_email',    variable: 'GCP_CLIENT_EMAIL'),
                    string(credentialsId: 'gcp_private_key',     variable: 'GCP_PRIVATE_KEY'),
                    string(credentialsId: 'gcp_storage_bucket',  variable: 'GCP_STORAGE_BUCKET'),
                    string(credentialsId: 'email_from_address',  variable: 'EMAIL_FROM_ADDRESS'),
                    string(credentialsId: 'email_password',  variable: 'EMAIL_PASSWORD'),
                    string(credentialsId: 'twilio_account_sid', variable: 'TWILIO_ACCOUNT_SID'),
                    string(credentialsId: 'twilio_auth_token', variable: 'TWILIO_AUTH_TOKEN'),
                    string(credentialsId: 'twilio_phone_number', variable: 'TWILIO_PHONE_NUMBER'),
                    string(credentialsId: 'app_encryption_key',  variable: 'APP_ENCRYPTION_KEY'),
                    string(credentialsId: 'db_encryption_key',  variable: 'DB_ENCRYPTION_KEY'),
                    string(credentialsId: 'contact_support_to',  variable: 'CONTACT_SUPPORT_TO'),
                    string(credentialsId: 'mtarget_username', variable: 'MTARGET_USERNAME'),
                    string(credentialsId: 'mtarget_password', variable: 'MTARGET_PASSWORD'),
                    string(credentialsId: 'mtarget_sender', variable: 'MTARGET_SENDER'),
                    string(credentialsId: 'mtarget_api_url', variable: 'MTARGET_API_URL'),
                    string(credentialsId: 'gemini_api_key', variable: 'GEMINI_API_KEY'),
                    string(credentialsId: 'two_factor_encryption_key', variable: 'TWO_FACTOR_ENCRYPTION_KEY'),
                    string(credentialsId: 'admin_jwt_secret', variable: 'ADMIN_JWT_SECRET'),
                    string(credentialsId: 'admin_jwt_refresh_secret', variable: 'ADMIN_JWT_REFRESH_SECRET'),
                    string(credentialsId: 'admin_subdomain', variable: 'ADMIN_SUBDOMAIN'),
                ]) {
                    sshagent([env.SSH_KEY_ID]) {
                        sh """
                        ssh -o StrictHostKeyChecking=no ${SSH_HOST} '
                            set -e
                            cd ${APP_DIR}

                            # Remove existing .env if any
                            rm -f .env

                            # Create .env file with actual secrets
                            cat > .env << EOF
NODE_ENV=production
PORT=3001

DATABASE_URL="${DATABASE_URL}"
JWT_SECRET="${JWT_SECRET}"
JWT_REFRESH_SECRET="${JWT_REFRESH_SECRET}"
JWT_EXPIRE_TIME=30m
JWT_REFRESH_EXPIRE_TIME=7d

EMAIL_SERVICE=resend
RESEND_API_KEY="${RESEND_API_KEY}"
EMAIL_FROM_NAME="BaoAfrik Team"
EMAIL_FROM_ADDRESS="no-reply@baoafrik.com"

# EMAIL_SERVICE="gmail"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# EMAIL_FROM_ADDRESS="${EMAIL_FROM_ADDRESS}"
# EMAIL_PASSWORD="${EMAIL_PASSWORD}"
# EMAIL_FROM_NAME="BaoAfrik Team"

GCP_PROJECT_ID="${GCP_PROJECT_ID}"
GCP_CLIENT_EMAIL="${GCP_CLIENT_EMAIL}"
GCP_PRIVATE_KEY="${GCP_PRIVATE_KEY}"
GCP_STORAGE_BUCKET="${GCP_STORAGE_BUCKET}"

STORAGE_PROFILE_PREFIX=profile-images
STORAGE_ATTACHMENTS_PREFIX=chat-attachments
STORAGE_PRODUCT_PREFIX=product-images

APP_ENCRYPTION_KEY="${APP_ENCRYPTION_KEY}"
DB_ENCRYPTION_KEY="${DB_ENCRYPTION_KEY}"

FRONTEND_URL="https://${DOMAIN}"
CORS_ORIGINS="https://${DOMAIN}"
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

TWILIO_ACCOUNT_SID="${TWILIO_ACCOUNT_SID}"
TWILIO_AUTH_TOKEN="${TWILIO_AUTH_TOKEN}"
TWILIO_PHONE_NUMBER="${TWILIO_PHONE_NUMBER}"

CONTACT_SUPPORT_TO="${CONTACT_SUPPORT_TO}"

ANALYTICS_ENABLED="true"
ANALYTICS_TIMEZONE="UTC"
WEEKLY_REPORT_ENABLED="true"
WEEKLY_REPORT_DAY="monday"
WEEKLY_REPORT_HOUR="9"
WEEKLY_REPORT_MINUTE="0"
WEEKLY_REPORT_RECIPIENTS="${WEEKLY_REPORT_RECIPIENTS}"
WEEKLY_REPORT_INCLUDE_TRENDS="true"
WEEKLY_REPORT_INCLUDE_DAILY="true"

REPORTS_DIR="./reports"
REPORTS_RETENTION_DAYS="30"

REMINDER_INTERVAL_MINUTES=10
MAX_REMINDERS_PER_MESSAGE=1

TWO_FACTOR_ENCRYPTION_KEY="${TWO_FACTOR_ENCRYPTION_KEY}"
TWO_FACTOR_ISSUER="Google"

ADMIN_JWT_SECRET="${ADMIN_JWT_SECRET}"
ADMIN_JWT_REFRESH_SECRET="${ADMIN_JWT_REFRESH_SECRET}"
ADMIN_JWT_EXPIRE_TIME="15m"
ADMIN_JWT_REFRESH_EXPIRE_TIME="7d"
ADMIN_SUBDOMAIN="${ADMIN_SUBDOMAIN}"

GEMINI_API_KEY="${GEMINI_API_KEY}"
ASSISTANT_MODEL="gemini-3.1-flash-lite"

SMS_PROVIDER=mtarget
MTARGET_USERNAME="${MTARGET_USERNAME}"
MTARGET_PASSWORD="${MTARGET_PASSWORD}"
MTARGET_SENDER="${MTARGET_SENDER}"
MTARGET_API_URL="${MTARGET_API_URL}"
EOF

                            chmod 600 .env
                        '
                        """
                    }
                }
            }
        }

        stage('Deploy backend on server ') {
            steps {
                echo 'Deploying backend on server...'

                sshagent([env.SSH_KEY_ID]) {
                    sh """
                    ssh -o StrictHostKeyChecking=no ${SSH_HOST} '
                        echo "Starting backend deployment..."

                        cd ${APP_DIR}

                        if [ ! -f .env ]; then
                            echo "ERROR: .env file not found!"
                            exit 1
                        fi

                        rm -rf dist/

                        # Install from the lockfile when available (faster and reproducible)
                        if [ -f package-lock.json ]; then
                            npm ci
                        else
                            npm install
                        fi

                        # Prisma 8 preflight
                        if [ ! -f prisma.config.ts ]; then
                            echo "ERROR: prisma.config.ts not found - this app is not on Prisma 8 yet."
                            exit 1
                        fi
                        if ! grep -q "^DATABASE_URL=" .env; then
                            echo "ERROR: DATABASE_URL is missing from .env"
                            exit 1
                        fi

                        # Prisma 8: emit contract.json / contract.d.ts (offline, required before build)
                        npx prisma contract emit

                        # Side-by-side migration only: keep the legacy Prisma 7 client generated
                        if grep -q "@prisma/prisma7" package.json; then
                            npx prisma7 generate
                        fi

                        # Build before migrating: a failed build must never touch the database
                        npm run build

                        # One-time adoption of the existing database (Prisma 7 -> 8 cutover only)
                        if [ "${params.PRISMA_SIGN_DB}" = "true" ]; then
                            npx prisma db sign
                        fi

                        # Production audit trail (read-only, never fails the deploy)
                        npx prisma migration status || true
                        npx prisma db migrate --show || true

                        # Apply checked-in migrations, advance the ref, then fail on any drift
                        npx prisma db migrate --advance-ref db
                        npx prisma db verify

                        pm2 reload ${APP_NAME} --update-env || (pm2 delete ${APP_NAME} || true; pm2 start dist/server.js --name ${APP_NAME} -- --port 3001)
                        pm2 save

                        echo "Backend deployed successfully."
                    '
                    """
                }
            }
        }
    }

    post {
        always {
            script {
                emailext(
                        subject: "${env.JOB_NAME} - Build #${env.BUILD_NUMBER} - ${currentBuild.currentResult}",
                        to: "${env.EMAIL}",
                        from: 'jenkins.baoafrik.com',
                        replyTo: 'no-reply@baoafrik.com',
                        body: """
                            <html>
                                <body style="font-family: Arial, sans-serif; line-height: 1.5; color: #333;">
                                    <h2 style="color: #2E86C1;">Jenkins Build Notification</h2>
                                    <p><strong>Job:</strong> ${env.JOB_NAME}</p>
                                    <p><strong>Build Number:</strong> ${env.BUILD_NUMBER}</p>
                                    <p><strong>Status:</strong> <span style="color: ${currentBuild.currentResult == 'SUCCESS' ? 'green' : 'red'};">${currentBuild.currentResult}</span></p>
                                    <p>Check the <a href="${env.BUILD_URL}">console output</a> for details.</p>
                                    <hr>
                                    <p style="font-size: 0.9em; color: #565;">This is an automated email from Jenkins. Please do not reply.</p>
                                </body>
                            </html>
                        """,
                        mimeType: 'text/html'
                    )
            }
        }
        success {
            script {
                emailext(
                subject: "${env.JOB_NAME} - ${currentBuild.currentResult}",
                to: "${env.BAOTECHNOLOGIES_DEV_TEAM}",
                from: 'jenkins.baoafrik.com',
                replyTo: 'no-reply@baoafrik.com',
                body: """
                    <html>
                        <body style="font-family: Arial, sans-serif; line-height: 1.5; color: #333;">
                            <h2 style="color: #2E86C1;">BaoAfrik Production Notification</h2>
                            <p><strong>Job:</strong> ${env.JOB_NAME}</p>
                            <p><strong>Status:</strong> <span style="color: ${currentBuild.currentResult == 'SUCCESS' ? 'green' : 'red'};">${currentBuild.currentResult}</span></p>
                            <p>Check the <a href="${env.BUILD_URL}"> console output</a> for details and also see recent changes at <a href="${env.DOMAIN}"></a>.</p>
                            <hr>
                            <p style="font-size: 0.9em; color: #565;">This is an automated email from Jenkins. Please do not reply.</p>
                        </body>
                    </html>
                """,
                mimeType: 'text/html'
                )

                // Send Slack notification with release notes
                generateAndSendReleaseNotes()

                // Update last deployed commit
                sshagent([env.SSH_KEY_ID]) {
                    sh """
                    ssh -o StrictHostKeyChecking=no ${SSH_HOST} '
                        CURRENT_COMMIT=\$(cd ${APP_DIR} && git rev-parse HEAD 2>/dev/null)
                        if [ -n "\$CURRENT_COMMIT" ]; then
                            echo "\$CURRENT_COMMIT" > ${LAST_COMMIT_FILE}
                        fi
                    '
                    """
                }
            }
        }
    }
}
